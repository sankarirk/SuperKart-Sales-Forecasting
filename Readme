                         └──────────┬───────────┘
                                    │
                                    ▼
                         ┌──────────────────────┐
                         │ Streamlit Frontend   │
                         │                      │
                         │     Render Cloud     │
                         └──────────┬───────────┘
                                    │
                                    │ HTTP POST
                                    ▼
                    ┌───────────────────────────────┐
                    │       Flask REST API          │
                    │                               │
                    │       /health                 │
                    │       /v1/predict             │
                    └──────────────┬────────────────┘
                                   │
                                   ▼
                    ┌───────────────────────────────┐
                    │ Scikit-learn Pipeline         │
                    │                               │
                    │ StandardScaler                │
                    │ OneHotEncoder                 │
                    │ RandomForestRegressor          │
                    └──────────────┬────────────────┘
                                   │
                                   ▼
                         ┌──────────────────────┐
                         │ Predicted Sales      │
                         │                      │
                         │ Revenue Prediction   │
                         └──────────────────────┘
